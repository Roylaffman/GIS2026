# Copy to .env and fill in real values (never commit .env)

# OpenTopography API key (https://opentopography.org -> "API Access")
OPENTOPO_API_KEY=

# SerpAPI key (https://serpapi.com/manage-api-key) — 64 hex chars
SERPAPI_KEY=

# Mapbox public access token (https://account.mapbox.com/access-tokens/)
MAPBOX_TOKEN=

# Google Cloud Storage bucket (GCS)
GCS_BUCKET=gs://www.geoglypha1.org
